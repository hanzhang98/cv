# Required for live Telegram delivery
TELEGRAM_BOT_TOKEN=

# Optional: restrict who can talk to the bot (comma-separated numeric chat IDs)
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional Twitter/X bearer token (v2 recent search). Without it, Twitter uses fixtures + curated RSS mirrors.
TWITTER_BEARER_TOKEN=

# Optional OpenAI-compatible key for richer theme summaries later
OPENAI_API_KEY=

# Runtime
BOT_MODE=demo
# BOT_MODE=live  # use live Substack RSS + Twitter API when available
LOG_LEVEL=INFO